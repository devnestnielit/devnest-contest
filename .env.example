# FirstByte admin login.
# Copy this file to .env and set your own PIN. The site checks the PIN
# server-side (api/admin.js) against ADMIN_PIN — it is never in the code.
# Local runs (server.cjs) read .env automatically.
# On Vercel, set ADMIN_PIN in the dashboard instead:
# Project Settings -> Environment Variables -> Add (ADMIN_PIN = your PIN),
# then redeploy. A .env file is NOT read by Vercel in production.
# Default when unset: devnest
ADMIN_PIN=devnest
